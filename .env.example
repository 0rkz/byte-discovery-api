# Server port
PORT=3500

# Arbitrum Sepolia RPC endpoint
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Byte Protocol indexer API (for publisher enumeration)
INDEXER_URL=http://localhost:8080

# x402 payment gateway URL
X402_GATEWAY=http://localhost:3402

# Base URL used ONLY for the server-side gateway /feeds fetch. Defaults to
# X402_GATEWAY. Set it to the gateway on loopback to keep that fetch off the
# public rate-limit bucket. Never advertised to agents.
X402_GATEWAY_FETCH=http://127.0.0.1:3402

# Deadline in ms for the server's own outbound fetches (indexer + gateway).
GATEWAY_FETCH_TIMEOUT_MS=5000

# How long an assembled catalog is reused before rebuilding, in ms. 0 = off.
CATALOG_CACHE_TTL_MS=10000

# Oldest last-good catalog still served (labelled `degraded`) while an
# upstream read keeps failing, in ms. Older than this -> 503. Default 15 min.
LAST_GOOD_MAX_AGE_MS=900000

# How long a no-last-good 503 is re-served without retrying the upstreams,
# in ms. Bounds the sequential fetch rate of a cold start. 0 = off.
CATALOG_FAILURE_CACHE_MS=2000

# All four *_MS values: empty = not set (default applies); a value that does
# not parse or is below its floor falls back to the default with one
# `[config]` log line. A timeout of 0 would abort every fetch.
